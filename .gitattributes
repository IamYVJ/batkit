# Auto detect text files and perform LF normalization
* text=auto

# Windows scripts must stay CRLF, in the repo and in every checkout
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Generated/web/docs files stay LF so the build output is identical on every OS
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
